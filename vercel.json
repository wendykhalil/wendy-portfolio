{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!images/|assets/|files/|favicon\\.svg|robots\\.txt|.*\\.json|.*\\.xml|.*\\.svg|.*\\.jpg|.*\\.jpeg|.*\\.png|.*\\.gif|.*\\.webp|.*\\.css|.*\\.js|.*\\.map|.*\\.pdf|.*\\.woff|.*\\.woff2).*)$",
      "destination": "/index.html"
    }
  ]
}
